{
  "apiVersion": "dekopon.dev/provider/v1alpha1",
  "id": "ripgrep",
  "description": "Searches bounded caller-supplied UTF-8 virtual documents with Rust ripgrep matchers; never reads paths or performs I/O",
  "capabilities": [
    {
      "id": "ripgrep.search",
      "description": "Search 1–16 virtual documents in caller order with bounded regex/fixed matching, context, byte offsets, and deterministic truncation",
      "effect": "read-only",
      "risk": "Low",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "case": {
            "default": "sensitive",
            "enum": [
              "sensitive",
              "insensitive",
              "smart"
            ],
            "type": "string"
          },
          "context": {
            "additionalProperties": false,
            "default": {
              "after": 0,
              "before": 0
            },
            "properties": {
              "after": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "before": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "before",
              "after"
            ],
            "type": "object"
          },
          "documents": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "text"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "invert": {
            "default": false,
            "type": "boolean"
          },
          "line": {
            "default": false,
            "type": "boolean"
          },
          "max_results": {
            "default": 100,
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "mode": {
            "default": "regex",
            "enum": [
              "regex",
              "fixed"
            ],
            "type": "string"
          },
          "multiline": {
            "default": false,
            "type": "boolean"
          },
          "pattern": {
            "type": "string"
          },
          "word": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "documents",
          "pattern"
        ],
        "type": "object"
      }
    }
  ],
  "commandWords": [
    "rg"
  ]
}
